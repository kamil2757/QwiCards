{
  "expo": {
    "name": "QwiCards",
    "slug": "QwiCards",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/qwiCards.png",
    "scheme": "qwicards",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kamil.qwicards",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/qwiCards.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/qwiCards.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/qwiCards.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1379c20d-e2c6-41a5-8fd1-1eff0e6fe0c0"
      }
    },
    "owner": "kamil2757",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1379c20d-e2c6-41a5-8fd1-1eff0e6fe0c0"
    }
  }
}
